{
  "rules": [
    { "id": "@secretlint/secretlint-rule-preset-recommend" },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Groq API key",
            "patterns": ["/gsk_[A-Za-z0-9]{40,}/"]
          },
          {
            "name": "Google or Firebase API key",
            "patterns": ["/AIza[0-9A-Za-z_\\-]{35}/"]
          },
          {
            "name": "Committed env file",
            "filePathGlobs": ["**/.env", "**/.env.local", "**/.env.production"]
          }
        ]
      }
    }
  ]
}
