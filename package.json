  "scripts": {
    "start:go": "expo start --go",
    "start:go:tunnel": "expo start --go --tunnel",
    "start:dev": "expo start --dev-client",
    "start": "expo start --go",
    "build:android:dev": "npx eas-cli@latest build --profile development --platform android",
    "build:editor": "node scripts/build-editor.mjs",
    "check:editor": "node scripts/build-editor.mjs --check",
    "build:fonts": "node scripts/subset-fonts.mjs",
    "check:fonts": "node scripts/subset-fonts.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "jest --ci",
    "test:watch": "jest --watch",
    "secrets:scan": "secretlint --maskSecrets \"**/*\"",
    "audit:prod": "npm audit --omit=dev --audit-level=low",
    "audit:all": "npm audit --audit-level=moderate",
    "bundle:check": "expo export --platform android --platform ios --output-dir dist-check",
    
    "verify": "npm run check:editor && npm run check:legal && npm run check:fonts && npm run typecheck && npm run lint && npm test && npm run secrets:scan && npm run audit:prod",
    "export:phase": "node scripts/export-phase.mjs",
    "test:sync-e2e": "node scripts/test-sync-e2e.mjs",
    "check:legal": "node scripts/build-legal.mjs --check",
    "emu:verify": "node scripts/emu-verify-email.mjs",
    "emulators:lan": "node scripts/emulators-lan.mjs",
    "build:android:emulator": "npx eas-cli@latest build --profile emulator --platform android"
  },
  "private": true,
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
