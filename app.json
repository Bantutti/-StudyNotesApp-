{
  "expo": {
    "name": "NotedPo",
    "slug": "notedpo",
    "scheme": "notedpo",
    "version": "0.0.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.bantutti.notedpo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.github.bantutti.notedpo",
      "adaptiveIcon": {
        "backgroundColor": "#FDEEF3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_PHONE_STATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "NotedPo records lectures only when you tap Record. Audio stays on this device unless you choose to transcribe it.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      "expo-sharing",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "NotedPo uses the camera only when you tap Take a photo in Match a look. The photo is used on this phone to find a matching look and is not kept.",
          "microphonePermission": "NotedPo records lectures only when you tap Record. Audio stays on this device unless you choose to transcribe it."
        }
      ],
      "./plugins/withEmulatorCleartext"
    ]
  }
}
