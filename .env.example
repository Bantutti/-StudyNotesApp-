# Copy this file to .env (never commit .env).
# Your Groq key is typed into the app on your phone and stored in the
# phone's secure storage, never in this file.
#
# Public Expo variables must start with EXPO_PUBLIC_ and are NOT secret
# (they ship inside the app).
EXPO_PUBLIC_APP_ENV=development

# --- P2b sign-in and sync: LOCAL FIREBASE EMULATORS ONLY -------------------
# Leave these commented out for a local-only app (no sync screens).
# To test sync against the emulators on your PC (TESTING_ON_DEVICE.md, P2b):
#   1. find your PC's Wi-Fi IPv4 address (PowerShell: ipconfig)
#   2. uncomment both lines and put that address below
# The app refuses an emulator host unless the project id starts with demo-.
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-studynotes
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.1.20
