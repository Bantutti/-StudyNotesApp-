# Copy this file to .env (never commit .env).
# P0 needs NO secrets. Your Groq key is typed into the app on your phone
# and stored in the phone's secure storage, never in this file.
#
# Firebase settings arrive in P2. Public Expo variables must start with
# EXPO_PUBLIC_ and are NOT secret (they ship inside the app).
EXPO_PUBLIC_APP_ENV=development
