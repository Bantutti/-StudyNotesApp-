{
  "name": "studynotes-firebase",
  "version": "0.1.0",
  "private": true,
  "description": "Study Notes App backend (P2a): Firestore and Storage rules, zod schemas, emulator tests and the account deletion module. Emulator only, project demo-studynotes.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "emulators": "firebase emulators:start --project demo-studynotes",
    "test": "firebase emulators:exec --project demo-studynotes --only auth,firestore,storage \"vitest run\"",
    "test:unit": "vitest run tests/unit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "gate": "npm run typecheck && npm run lint && npm test && npm run audit",
    "audit:all": "npm audit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "uuid": "11.1.1",
    "minimatch@>=9 <11.0.1": "11.0.3",
    "glob@>=9 <14.0.2": "14.0.3"
  }
}
